{
  "name": "@redishfish/bluewhale-core",
  "version": "1.2.0",
  "description": "TypeScript implementation of the Bluewhale",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "bun": "./dist/index.mjs",
      "deno": "./dist/index.mjs",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js",
      "default": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "bin": {
    "stellar-route": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts src/cli.ts --format cjs,esm --dts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:bun": "bun test ./tests/runtime/bun.smoke.ts",
    "test:deno": "deno test --allow-read --allow-env tests/runtime/deno.smoke.ts",
    "lint": "eslint src/**/*.ts"
  },
  "peerDependencies": {
    "@stellar/stellar-sdk": ">=10.0.0"
  },
  "devDependencies": {
    "@redishfish/bluewhale-spec": "workspace:*",
    "@stellar/stellar-sdk": "^17.2.1",
    "eslint": "^10.13.0",
    "tsup": "^9.0.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "commander": "^15.0.0"
  }
}