{
  "name": "@redishfish/bluewhale",
  "version": "0.1.0",
  "description": "Bluewhale – React UI components (address input, type badge, warnings, memo)",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles/components.css",
    "./package.json": "./package.json"
  },
  "files": ["dist"],
  "sideEffects": [
    "*.css"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc && node -e \"require('node:fs').cpSync('src/styles', 'dist/styles', { recursive: true })\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "ladle": "ladle serve",
    "build-storybook": "ladle build"
  },
  "dependencies": {
    "@redishfish/bluewhale-core": "workspace:^"
  },
  "peerDependencies": {
    "react": ">=17.0.0"
  },
  "devDependencies": {
    "@ladle/react": "5.1.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/react": "^19.3.0",
    "jsdom": "30.1.3",
    "react": "^19.3.1",
    "react-dom": "19.3.1",
    "typescript": "^7.0.2",
    "vitest": "5.0.5"
  }
}
