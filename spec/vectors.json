      "module": "muxed_decode",
      "description": "decode id=2^64-1 max uint64",
      "input": {
        "mAddress": "MAYCUYT553C5LHVE2XPW5GMEJT4BXGM7AHMJWLAPZP53KJO7EIQAD7777777777774OFW"
