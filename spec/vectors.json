{
  "spec_version": "1.2.0",
  "description": "Normative test vectors for the Bluewhale. This file is the single source of truth for routing logic across TypeScript, Go, and Dart implementations. Any change to routing behavior MUST start here.",
  "cases": [
    {
      "module": "muxed_encode",
      "description": "encode id=0: minimum uint64 boundary; ensures zero-padding and no off-by-one in id encoding",
      "input": {
        "base_g": "GAYCUYT553C5LHVE2XPW5GMEJT4BXGM7AHMJWLAPZP53KJO7EIQADRSI",
        "id": "0"
      },
      "expected": {
        "mAddress": "MAYCUYT553C5LHVE2XPW5GMEJT4BXGM7AHMJWLAPZP53KJO7EIQACAAAAAAAAAAAAD672"
      },
      "tags": ["positive", "edge"]
    },
    {
      "module": "muxed_encode",
      "description": "encode id=1: smallest positive id; exercises single-byte id encoding",
      "input": {
        "base_g": "GAYCUYT553C5LHVE2XPW5GMEJT4BXGM7AHMJWLAPZP53KJO7EIQADRSI",
        "id": "1"
      },
      "expected": {
        "mAddress": "MAYCUYT553C5LHVE2XPW5GMEJT4BXGM7AHMJWLAPZP53KJO7EIQACAAAAAAAAAAAAHOO2"
      },
      "tags": ["positive", "edge"]
    },
    {
      "module": "muxed_encode",
      "description": "encode id=2^53: JavaScript Number safe-integer boundary; last id representable exactly as JS number",
      "input": {
        "base_g": "GAYCUYT553C5LHVE2XPW5GMEJT4BXGM7AHMJWLAPZP53KJO7EIQADRSI",
        "id": "9007199254740992"
      },
      "expected": {
        "mAddress": "MAYCUYT553C5LHVE2XPW5GMEJT4BXGM7AHMJWLAPZP53KJO7EIQACABAAAAAAAAAAAFZG"
      },
      "tags": ["positive", "edge", "interop"]
    },
    {
      "module": "muxed_encode",
      "description": "encode id=2^53+1: above JS safe integer; requires string/BigInt to avoid silent corruption; interop canary",
      "input": {
        "base_g": "GAYCUYT553C5LHVE2XPW5GMEJT4BXGM7AHMJWLAPZP53KJO7EIQADRSI",
        "id": "9007199254740993"
      },
      "expected": {
        "mAddress": "MAYCUYT553C5LHVE2XPW5GMEJT4BXGM7AHMJWLAPZP53KJO7EIQACABAAAAAAAAAAEVIG"
      },
      "tags": ["positive", "edge", "interop"]
    },
    {
      "module": "muxed_encode",
      "description": "encode id=2^64-1: maximum uint64; proves full range support and no truncation",
      "input": {
        "base_g": "GAYCUYT553C5LHVE2XPW5GMEJT4BXGM7AHMJWLAPZP53KJO7EIQADRSI",
        "id": "18446744073709551615"
      },
      "expected": {
        "mAddress": "MAYCUYT553C5LHVE2XPW5GMEJT4BXGM7AHMJWLAPZP53KJO7EIQAD7777777777774OFW"
      },
      "tags": ["positive", "edge", "interop"]
    },
    {
      "module": "muxed_decode",
      "description": "decode id=0 boundary case",
      "input": {
        "mAddress": "MAYCUYT553C5LHVE2XPW5GMEJT4BXGM7AHMJWLAPZP53KJO7EIQACAAAAAAAAAAAAD672"
      },
      "expected": {
        "base_g": "GAYCUYT553C5LHVE2XPW5GMEJT4BXGM7AHMJWLAPZP53KJO7EIQADRSI",
        "baseG": "GAYCUYT553C5LHVE2XPW5GMEJT4BXGM7AHMJWLAPZP53KJO7EIQADRSI",
        "id": "0"
      },
      "tags": ["positive", "edge"]
    },
    {
      "module": "muxed_decode",
      "description": "decode id=1 small positive case",
      "input": {
        "mAddress": "MAYCUYT553C5LHVE2XPW5GMEJT4BXGM7AHMJWLAPZP53KJO7EIQACAAAAAAAAAAAAHOO2"
      },
      "expected": {
        "base_g": "GAYCUYT553C5LHVE2XPW5GMEJT4BXGM7AHMJWLAPZP53KJO7EIQADRSI",
        "baseG": "GAYCUYT553C5LHVE2XPW5GMEJT4BXGM7AHMJWLAPZP53KJO7EIQADRSI",
        "id": "1"
      },
      "tags": ["positive", "edge"]
    },
    {
      "module": "muxed_decode",
      "description": "decode id=2^53 precision boundary",
      "input": {
        "mAddress": "MAYCUYT553C5LHVE2XPW5GMEJT4BXGM7AHMJWLAPZP53KJO7EIQACABAAAAAAAAAAAFZG"
      },
      "expected": {
        "base_g": "GAYCUYT553C5LHVE2XPW5GMEJT4BXGM7AHMJWLAPZP53KJO7EIQADRSI",
