        "id": "18446744073709551615"
      },
      "tags": ["positive", "edge", "interop"]
    },
    {
      "module": "muxed_decode",
      "description": "invalid M-address should return decode error",
      "input": {
        "mAddress": "MZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZZ"
      },
      "expected": {
        "expected_error": "invalid encoded string"
      },
      "tags": ["negative", "edge"]
    },
    {
      "module": "muxed_decode",
      "description": "M-address with non-zero trailing unused bits in Base32 encoding must return decode error",
      "input": {
        "mAddress": "MAYCUYT553C5LHVE2XPW5GMEJT4BXGM7AHMJWLAPZP53KJO7EIQACAAAAAAAAAAAAD673"
      },
      "expected": {
        "expected_error": "unused bits in base32 encoding must be zero"
      },
      "tags": ["negative", "edge"]
    },
    {
      "module": "detect",
      "description": "lowercase G accepted with normalization warning",
      "input": {
        "address": "gaycuyt553c5lhve2xpw5gmejt4bxgm7ahmjwlapzp53kjo7eiqadrsi"
      },
      "expected": {
        "kind": "G",
        "address": "GAYCUYT553C5LHVE2XPW5GMEJT4BXGM7AHMJWLAPZP53KJO7EIQADRSI",
        "warnings": [
          {
            "code": "NON_CANONICAL_ADDRESS",
            "severity": "warn",
            "message": "lowercase address was normalized to uppercase",
            "normalization": {
              "original": "gaycuyt553c5lhve2xpw5gmejt4bxgm7ahmjwlapzp53kjo7eiqadrsi",
              "normalized": "GAYCUYT553C5LHVE2XPW5GMEJT4BXGM7AHMJWLAPZP53KJO7EIQADRSI"
            }
          }
        ]
      },
      "tags": ["negative", "edge"]
    },
    {
      "module": "extract_routing",
      "description": "M-address routing (no memo)",
      "input": {
        "destination": "MA7QYNF7SZFX4X7X5JFZZ3UQ6BXHDSY2RKVKZKX5FFQJ1ZMZX1AAJZRE6LRE6LRE6LRE6LRE6LRE6LRE6LRE6LRE6LRE6LRE6LR",
        "memoType": "none"
      },
      "expected": {
        "destinationBaseAccount": "GA7QYNF7SZFX4X7X5JFZZ3UQ6BXHDSY2RKVKZKX5FFQJ1ZMZX1",
        "routingId": "9007199254740993",
        "routingSource": "muxed",
        "warnings": []
      },
      "tags": ["positive", "interop"]
    },
    {
      "module": "extract_routing",
      "description": "C-address rejection",
      "input": {
        "destination": "CA7QYNF7SZFX4X7X5JFZZ3UQ6BXHDSY2RKVKZKX5FFQJ1ZMZX1",
        "memoType": "none"
      },
      "expected": {
        "destinationBaseAccount": null,
        "routingId": null,
        "routingSource": "none",
        "warnings": [
          {
            "code": "INVALID_DESTINATION",
            "severity": "error",
            "message": "C address is not a valid destination",
            "context": {
              "destinationKind": "C"
            }
          }
        ]
      },
      "tags": ["negative"]
    },
    {
      "module": "extract_routing",
      "description": "G-address + MEMO_ID routing",
      "input": {
        "destination": "GA7QYNF7SZFX4X7X5JFZZ3UQ6BXHDSY2RKVKZKX5FFQJ1ZMZX1",
