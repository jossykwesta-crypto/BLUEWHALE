        "routingSource": "memo",
        "warnings": []
      },
      "tags": ["positive"]
    },
    {
      "module": "toml_lookup",
      "description": "valid apex domain resolves stellar.toml at well-known path",
      "input": {
        "domain": "example.com"
      },
      "expected": {
        "url": "https://example.com/.well-known/stellar.toml",
        "error": null
      },
      "tags": ["positive", "sep-0029"]
    },
    {
      "module": "toml_lookup",
      "description": "valid subdomain resolves stellar.toml at well-known path",
      "input": {
        "domain": "wallet.example.com"
      },
      "expected": {
        "url": "https://wallet.example.com/.well-known/stellar.toml",
        "error": null
      },
      "tags": ["positive", "sep-0029"]
    },
    {
      "module": "toml_lookup",
      "description": "domain with invalid characters (underscore) must be rejected with INVALID_DOMAIN_NAME",
