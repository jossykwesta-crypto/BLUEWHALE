{
  "$schema": "http://json-schema.org/draft-07/schema",
  "definitions": {
    "routingId": {
      "type": "string",
      "pattern": "^[0-9]{1,20}$",
      "maxUint64": true
    },
    "warningNormalization": {
      "type": "object",
      "required": ["code", "severity", "message", "normalization"],
      "additionalProperties": false,
      "properties": {
        "code": { "type": "string", "enum": ["NON_CANONICAL_ADDRESS", "NON_CANONICAL_ROUTING_ID"] },
        "severity": { "type": "string", "const": "warn" },
        "message": { "type": "string" },
        "normalization": {
          "type": "object",
          "required": ["original", "normalized"],
          "additionalProperties": false,
          "properties": {
            "original": { "type": "string" },
            "normalized": { "type": "string" }
          }
        }
      }
    },
    "warningInvalidDestination": {
      "type": "object",
      "required": ["code", "severity", "message", "context"],
      "additionalProperties": false,
      "properties": {
        "code": { "type": "string", "const": "INVALID_DESTINATION" },
        "severity": { "type": "string", "const": "error" },
        "message": { "type": "string" },
        "context": {
          "type": "object",
          "required": ["destinationKind"],
          "additionalProperties": false,
          "properties": {
            "destinationKind": { "type": "string", "const": "C" }
          }
        }
      }
    },
    "warningUnsupportedMemoType": {
      "type": "object",
      "required": ["code", "severity", "message", "context"],
      "additionalProperties": false,
      "properties": {
        "code": { "type": "string", "const": "UNSUPPORTED_MEMO_TYPE" },
        "severity": { "type": "string", "const": "warn" },
        "message": { "type": "string" },
        "context": {
          "type": "object",
          "required": ["memoType"],
          "additionalProperties": false,
          "properties": {
            "memoType": { "type": "string", "enum": ["hash", "return", "unknown"] }
          }
        }
      }
    },
    "warningMemoTextTooLong": {
      "type": "object",
      "required": ["code", "severity", "message", "context"],
      "additionalProperties": false,
      "properties": {
        "code": { "type": "string", "const": "MEMO_TEXT_TOO_LONG" },
        "severity": { "type": "string", "const": "error" },
        "message": { "type": "string" },
        "context": {
          "type": "object",
          "required": ["byteLength", "maxByteLength"],
          "additionalProperties": false,
          "properties": {
            "byteLength": { "type": "integer", "minimum": 0 },
            "maxByteLength": { "type": "integer", "const": 28 }
          }
        }
      }
    },
    "warningGeneric": {
      "type": "object",
      "required": ["code", "severity", "message"],
      "additionalProperties": false,
      "properties": {
        "code": {
          "type": "string",
          "enum": [
            "MEMO_IGNORED_FOR_MUXED", "MEMO_PRESENT_WITH_MUXED",
            "CONTRACT_SENDER_DETECTED", "MEMO_TEXT_UNROUTABLE",
            "MEMO_ID_INVALID_FORMAT", "MISSING_REQUIRED_MEMO",
            "INVALID_STRKEY"
          ]
        },
        "severity": { "type": "string", "enum": ["info", "warn", "error"] },
        "message": { "type": "string" }
      }
    },
    "errorCode": {
      "type": "string",
      "enum": [
        "INVALID_CHECKSUM", "INVALID_LENGTH", "INVALID_BASE32",
        "INVALID_STRKEY_LENGTH",
        "UNKNOWN_PREFIX", "REJECTED_SEED_KEY", "REJECTED_PREAUTH",
        "REJECTED_HASH_X", "FEDERATION_ADDRESS_NOT_SUPPORTED",
        "INVALID_DOMAIN_NAME"
      ]
    },
    "destinationError": {
      "type": "object",
      "required": ["code", "message"],
      "properties": {
        "code": { "$ref": "#/definitions/errorCode" },
        "message": { "type": "string" }
      }
    },
    "domainName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 253,
      "pattern": "^(?=.{1,253}$)([a-zA-Z0-9]([a-zA-Z0-9-]{0,61}[a-zA-Z0-9])?)(\\.[a-zA-Z0-9]([a-zA-Z0-9-]{0,61}[a-zA-Z0-9])?)*$"
    },
    "warning": {
      "oneOf": [
        { "$ref": "#/definitions/warningNormalization" },
        { "$ref": "#/definitions/warningInvalidDestination" },
        { "$ref": "#/definitions/warningUnsupportedMemoType" },
        { "$ref": "#/definitions/warningMemoTextTooLong" },
        { "$ref": "#/definitions/warningGeneric" }
      ]
    },
    "addressKind": {
      "type": "string",
      "enum": ["KindG", "KindC", "KindM", "KindUnknown"]
    }
  },
  "type": "object",
  "required": ["spec_version", "cases"],
  "properties": {
    "spec_version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "cases": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["module", "description", "input", "expected", "tags"],
        "properties": {
          "module": {
            "type": "string",
            "enum": ["detect", "muxed_encode", "muxed_decode", "extract_routing", "extract_from_uri", "toml_lookup"]
          },
          "description": { "type": "string" },
          "input": {
            "type": "object",
            "properties": {
              "routingId": { "$ref": "#/definitions/routingId" },
              "memo": {
                "type": "object",
                "required": ["type", "value"],
                "additionalProperties": false,
                "properties": {
                  "type": { "type": "string", "enum": ["text", "id", "hash", "return"] },
                  "value": { "type": "string" }
                }
              }
            }
          },
          "expected": {
            "type": "object",
            "properties": {
              "kind": { "$ref": "#/definitions/addressKind" },
              "warnings": {
                "type": "array",
                "items": { "$ref": "#/definitions/warning" }
              },
              "destinationError": { "$ref": "#/definitions/destinationError" }
            }
          },
          "tags": {
            "type": "array",
            "items": {
              "enum": ["positive", "negative", "edge", "interop", "regression", "scope-boundary"]
            }
          },
          "notes": { "type": "string" }
        }
      }
    }
  }
}
